# Copy to .env.local for local dev. In production, set these in the hosting dashboard.
# Never commit real values. Only NEXT_PUBLIC_* values are ever sent to the browser.

# --- Hidden launch ---
# "true" opens /apply to everyone. Anything else = 404 (except in `next dev`).
REGISTRATION_ENABLED=false
# Optional. After this ISO date-time, /apply shows "Registration has closed" and refuses submissions.
# Example: 2026-11-01T06:59:59Z  (= Oct 31, 11:59 PM Pacific)
REGISTRATION_CLOSES_AT=
# Optional. Hard ceiling on total rows in the sheet (default 5000) so a flood can't fill it.
REGISTRATION_MAX_ROWS=
# Optional. Max registration submissions per IP per 10-minute window (default 10).
REGISTRATION_IP_RATE_LIMIT_MAX=
# Organizer preview link: /apply?preview=<token>. At least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REGISTRATION_PREVIEW_TOKEN=

# --- Cloudflare Turnstile (bot check) ---
# LOCAL DEV ONLY: these are Cloudflare's public always-pass TEST keys. The server refuses
# the test secret in production, so create a real widget at dash.cloudflare.com for launch.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Production: comma-separated hostnames the widget is allowed on (tokens from other hosts are refused).
# Leave empty for local dev.
TURNSTILE_ALLOWED_HOSTNAMES=

# --- Google Sheets (service account) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON key file, keeping the \n sequences, in quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The long ID in the sheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=

# --- Registration Cache (Vercel KV / Upstash Redis) ---
# Highly recommended for Vercel deployment to eliminate Google Sheets read quota usage.
# If using the Vercel Upstash integration or Vercel KV, these are injected automatically.
# In local development without Redis, it automatically falls back to an in-memory server cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alternatively, Vercel KV environment variables are also supported:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Optional HMAC secret for blind-indexing applicant emails. If omitted, GOOGLE_PRIVATE_KEY is used.
REGISTRATION_CACHE_SECRET=
